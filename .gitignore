# Generated run products and large intermediate data
runs/

# Notebooks históricos de la versión antigua (antes en la raíz). Se conservan en
# local para consulta; la interfaz actual es notebooks/<objeto>/ + musepipe/.
# Siguen en el historial de Git si hace falta recuperarlos.
legacy/

# Notebook and Python caches
.ipynb_checkpoints/
__pycache__/
*.py[cod]

# Local OS/editor noise
.DS_Store
.claude/settings.local.json
.claude/worktrees/

# Local active run selection; use MUSE_RUN_ID to override per command
active_run.txt

# Test/type-check/build caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Local environments
.venv/
venv/
env/
node_modules/

# Node tooling metadata (not part of the Python pipeline)
package.json
package-lock.json

# esorex reduction run log (transient)
esorex.log

# LaTeX auxiliary outputs; keep source/PDF decisions explicit
reports/**/*.aux
reports/**/*.log
reports/**/*.out
reports/**/*.toc
reports/**/*.synctex.gz

# Guias y documentos LaTeX de estructura: viven fuera del repo, y ademas traen
# sus artefactos de compilacion (.aux/.log/.out/.toc), que aqui no estan ignorados
# como si lo estan bajo reports/
docs/structure/

# Paper draft: shared via Overleaf, not in this repo (yet)
paper/

# Internal meeting slides: not part of the published pipeline
roxs12_reunion.pptx
roxs12_meeting_en.pptx
reports/**/*.pptx
