    given-names: "Ricardo"
    orcid: "https://orcid.org/0000-0002-4678-8361"
    affiliation: "Departamento de Física y Astronomía, Facultad de Ciencias Exactas, Universidad Andrés Bello, Santiago, Chile"
version: "0.1.0"
date-released: "2026-09-07"
license: BSD-3-Clause
repository-code: "https://github.com/RicardoRamirezReyes/musepipe"
keywords:
  - astronomy
  - integral field spectroscopy
  - VLT/MUSE
  - adaptive optics
  - accretion
  - substellar companions
  - point spread function
